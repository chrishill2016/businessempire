@inherits LayoutComponentBase
@implements IDisposable
@inject AppStatusService Status
@inject ISnackbar Snackbar

<MudThemeProvider Theme="AppTheme.Theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.ExtraSmall" CloseButton="true" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <a href="" class="d-flex align-center gap-2" style="text-decoration:none" aria-label="Home">
            <span class="app-icon-tile glow" style="width:32px;height:32px;border-radius:8px">
                <img src="icon.svg" alt="" width="24" height="24" />
            </span>
            <Wordmark />
        </a>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Inherit" Href="scores" aria-label="High scores" />
        <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Inherit" Href="settings" aria-label="Settings" />
    </MudAppBar>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

<AppFooter />

@code {
    private bool _wasOffline;

    protected override void OnInitialized()
    {
        Status.Changed += OnStatusChanged;
        Status.UpdateReady += OnUpdateReady;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Status.StartAsync();
        }
    }

    private void OnStatusChanged()
    {
        if (!Status.IsOnline)
        {
            _wasOffline = true;
        }
        else if (_wasOffline)
        {
            _wasOffline = false;
            Snackbar.Add("Back online.", Severity.Info);
        }
        InvokeAsync(StateHasChanged);
    }

    private void OnUpdateReady() => InvokeAsync(() =>
        Snackbar.Add(SnackbarExtensions.UpdateMessage, Severity.Info, options =>
        {
            options.RequireInteraction = true;
            options.Action = "Refresh";
            options.ActionColor = Color.Primary;
            options.OnClick = _ => Status.ApplyUpdateAsync().AsTask();
        }));

    public void Dispose()
    {
        Status.Changed -= OnStatusChanged;
        Status.UpdateReady -= OnUpdateReady;
    }
}
