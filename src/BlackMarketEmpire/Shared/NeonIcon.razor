@* Line icons from the Neon Underground design set. *@
<span class="neon-icon glow @(Kind == NeonIconKind.Heat ? "heat" : null) @Class" style="@Style">
    <svg width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
         stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
        @switch (Kind)
        {
            case NeonIconKind.Credits:
                <rect x="2.5" y="6" width="19" height="12" /><circle cx="12" cy="12" r="2.8" /><path d="M6 9.5v5M18 9.5v5" />
                break;
            case NeonIconKind.Goods:
                <path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5z" /><path d="M3 7.5 12 12l9-4.5M12 12v9" />
                break;
            case NeonIconKind.Deals:
                <rect x="3" y="7" width="18" height="13" /><path d="M9 7V5h6v2M3 12h18M11 12v2h2v-2" />
                break;
            case NeonIconKind.Heat:
                <path d="M12 21c-4 0-6.5-2.6-6.5-6 0-3.6 3-5.6 3.5-9 2 1.3 3 3.2 3 5 1-1 1.6-2.3 1.6-3.6 2.3 1.8 3.9 4.6 3.9 7.6 0 3.4-2.5 6-5.5 6z" />
                break;
            case NeonIconKind.Zones:
                <path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z" /><circle cx="12" cy="10" r="2.4" />
                break;
            case NeonIconKind.Vault:
                <rect x="3" y="3.5" width="18" height="16" /><circle cx="12" cy="11.5" r="4.5" /><path d="M12 7v2M12 14v2M7.5 11.5h2M14.5 11.5h2M6 19.5v1.5M18 19.5v1.5" />
                break;
            case NeonIconKind.Crew:
                <circle cx="9" cy="8" r="3" /><path d="M3.5 20c0-3.3 2.5-5.5 5.5-5.5s5.5 2.2 5.5 5.5" /><circle cx="17" cy="9" r="2.4" /><path d="M15.5 14.7c2.8-.4 5 1.6 5 4.8" />
                break;
            case NeonIconKind.Market:
                <path d="M3 20h18" /><path d="m4 16 5-5 4 3 7-8" /><path d="M15 6h5v5" />
                break;
            case NeonIconKind.Clock:
                <circle cx="12" cy="12" r="8.5" /><path d="M12 7v5l3.5 2" />
                break;
        }
    </svg>
</span>

@code {
    [Parameter, EditorRequired] public NeonIconKind Kind { get; set; }
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
}
