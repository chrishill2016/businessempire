@page "/"
@inject GameSession Session
@inject ProgressService Progress
@inject NavigationManager Nav

<PageTitle>Black Market Empire</PageTitle>

<div class="page">
    <MudStack Spacing="3" AlignItems="AlignItems.Center" Class="mt-4">
        <span class="app-icon-tile glow" style="width:112px;height:112px;border-radius:26px">
            <img src="icon.svg" alt="" width="84" height="84" />
        </span>
        <Wordmark Large="true" Center="true" />
        <div style="text-align:center;color:var(--bme-text-2);font-size:1.05rem;max-width:22rem">
            30 days. One suitcase. A loan shark who wants his money back.
        </div>
    </MudStack>

    @if (_loaded)
    {
        @if (Session.HasActiveRun)
        {
            var s = Session.State!;
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" Style="height:56px" Class="mt-4"
                       OnClick="@(() => Nav.NavigateTo("play"))">
                Continue · Day @s.Day · @GameCatalog.City(s.CityId).Name
            </MudButton>
            <div class="muted mt-1" style="text-align:center;font-size:.85rem">@RunLabel(s)</div>
        }

        <div class="panel pa-4 mt-4">
            <div class="eyebrow mb-2">@(Session.HasActiveRun ? "Or start a new run" : "New run")</div>
            <div class="difficulty-picker">
                @foreach (var d in Enum.GetValues<Difficulty>())
                {
                    <button type="button" class="difficulty-option @(d == _difficulty ? "selected" : null)" data-difficulty="@d"
                            @onclick="@(() => _difficulty = d)">
                        <span class="do-name">@d</span>
                        <span class="do-desc">@Describe(d)</span>
                    </button>
                }
            </div>
            <MudButton Variant="@(Session.HasActiveRun ? Variant.Outlined : Variant.Filled)" Color="Color.Primary" FullWidth="true"
                       Style="height:52px" Class="mt-3" OnClick="@(() => StartNew(false))">
                Start @_difficulty.ToString().ToLowerInvariant() run
            </MudButton>
        </div>

        <div class="panel pa-4 mt-3 daily-card">
            <div class="d-flex justify-space-between align-center">
                <div>
                    <div class="eyebrow">Daily challenge · @DateTime.Now.ToString("d MMM")</div>
                    <div class="muted" style="font-size:.9rem">Same start and same luck as everyone else today. Normal difficulty.</div>
                </div>
                @if (_dailyBest is { } best)
                {
                    <div style="text-align:right">
                        <div class="eyebrow">Your best</div>
                        <div class="money @(best < 0 ? "negative" : "positive")">@Money.Format(best)</div>
                    </div>
                }
            </div>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Class="mt-3" StartIcon="@Icons.Material.Filled.Today"
                       OnClick="@(() => StartNew(true))">Play today's challenge</MudButton>
        </div>

        <div class="home-links mt-3">
            <MudButton Variant="Variant.Text" Color="Color.Primary" Href="scores" StartIcon="@Icons.Material.Filled.EmojiEvents">Scores</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Primary" Href="stats" StartIcon="@Icons.Material.Filled.QueryStats">Stats</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Primary" Href="achievements" StartIcon="@Icons.Material.Filled.MilitaryTech">Awards</MudButton>
        </div>
    }

    <div class="panel pa-4 mt-4">
        <div class="eyebrow mb-3">How to play</div>
        <div class="howto">
            <div><NeonIcon Kind="NeonIconKind.Market" Size="18" /> Buy goods cheap in one city and sell them dear in another.</div>
            <div><NeonIcon Kind="NeonIconKind.Zones" Size="18" /> Every city has its own prices, and they change every day.</div>
            <div><NeonIcon Kind="NeonIconKind.Clock" Size="18" /> Travel by train, car, plane or boat. Each has its own fare, journey time and risk. Your debt grows every day.</div>
            <div><NeonIcon Kind="NeonIconKind.Goods" Size="18" /> Send goods with a courier to avoid carrying them, and buy gear to carry more or slip past the police.</div>
            <div><NeonIcon Kind="NeonIconKind.Deals" Size="18" /> Your suitcase has limited space, and bulky goods take more of it.</div>
            <div><NeonIcon Kind="NeonIconKind.Crew" Size="18" /> Watch the intel feed for price spikes and crashes in other cities. Some rumours are false. Pay informants, contacts and fixers for an edge.</div>
            <div><NeonIcon Kind="NeonIconKind.Heat" Size="18" /> The more you carry, the more likely police and customs stop you. You can run, bribe, fight or surrender. Get hurt too badly and you're dead.</div>
            <div><NeonIcon Kind="NeonIconKind.Credits" Size="18" /> After 30 days your score is cash plus savings, minus everything you owe. Anything unsold is worthless.</div>
        </div>
        <div class="mt-4" style="color:var(--bme-magenta);font-size:.9rem">
            It's a game. In real life, smuggling ends in prison or worse.
        </div>
    </div>
</div>

@code {
    private bool _loaded;
    private Difficulty _difficulty = Difficulty.Normal;
    private long? _dailyBest;

    protected override async Task OnInitializedAsync()
    {
        await Session.LoadAsync();
        var career = await Progress.GetCareerAsync();
        _dailyBest = career.DailyBest.TryGetValue(GameSession.TodaysChallenge, out var best) ? best : null;
        _loaded = true;
    }

    public static string Describe(Difficulty d) => d switch
    {
        Difficulty.Easy => "£5k cash, £3k debt at 3%. Fewer police.",
        Difficulty.Hard => "£1.5k cash, £7.5k debt at 7%. More police, smaller case.",
        _ => "£2.5k cash, £5k debt at 5%.",
    };

    public static string RunLabel(GameState s) =>
        s.IsDaily ? $"Daily challenge · {s.ChallengeDate}" : $"{s.Difficulty} run";

    private async Task StartNew(bool daily)
    {
        await Session.StartNewAsync(_difficulty, daily);
        Nav.NavigateTo("play");
    }
}
