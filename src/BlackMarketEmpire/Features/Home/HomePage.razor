@page "/"
@inject GameSession Session
@inject NavigationManager Nav

<PageTitle>Black Market Empire</PageTitle>

<div class="page">
    <MudStack Spacing="4" AlignItems="AlignItems.Center" Class="mt-6">
        <span class="app-icon-tile glow" style="width:132px;height:132px;border-radius:30px">
            <img src="icon.svg" alt="" width="100" height="100" />
        </span>
        <Wordmark Large="true" Center="true" />
        <div style="text-align:center;color:var(--bme-text-2);font-size:1.05rem;max-width:22rem">
            30 days. One suitcase. A loan shark who wants his money back.
        </div>

        @if (_loaded)
        {
            @if (Session.HasActiveRun)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" Style="height:56px"
                           OnClick="@(() => Nav.NavigateTo("play"))">
                    Continue · Day @Session.State!.Day · @GameCatalog.City(Session.State.CityId).Name
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Style="height:48px" OnClick="StartNew">New run</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" Style="height:56px" OnClick="StartNew">
                    Start a run
                </MudButton>
            }
            <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true" Href="scores" StartIcon="@Icons.Material.Filled.EmojiEvents">High scores</MudButton>
        }
    </MudStack>

    <div class="panel pa-4 mt-6">
        <div class="eyebrow mb-3">How to play</div>
        <div class="howto">
            <div><NeonIcon Kind="NeonIconKind.Market" Size="18" /> Buy goods cheap in one city and sell them dear in another.</div>
            <div><NeonIcon Kind="NeonIconKind.Zones" Size="18" /> Every city has its own prices, and they change every day.</div>
            <div><NeonIcon Kind="NeonIconKind.Clock" Size="18" /> Travel by train, car, plane or boat. Each has its own fare, journey time and risk. Your debt grows 5% every day.</div>
            <div><NeonIcon Kind="NeonIconKind.Goods" Size="18" /> Send goods with a courier to avoid carrying them, and buy gear to carry more or slip past the police.</div>
            <div><NeonIcon Kind="NeonIconKind.Deals" Size="18" /> Your suitcase holds 100 items.</div>
            <div><NeonIcon Kind="NeonIconKind.Crew" Size="18" /> Watch the intel feed for price spikes and crashes in other cities. Some rumours are false. Pay informants, contacts and fixers for an edge.</div>
            <div><NeonIcon Kind="NeonIconKind.Heat" Size="18" /> The more you carry, the more likely police and customs stop you. You can run, bribe, fight or surrender. Get hurt too badly and you're dead.</div>
            <div><NeonIcon Kind="NeonIconKind.Credits" Size="18" /> After 30 days your score is cash minus debt. Anything unsold is worthless.</div>
        </div>
        <div class="mt-4" style="color:var(--bme-magenta);font-size:.9rem">
            It's a game. In real life, smuggling ends in prison or worse.
        </div>
    </div>
</div>

@code {
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        await Session.LoadAsync();
        _loaded = true;
    }

    private async Task StartNew()
    {
        await Session.StartNewAsync();
        Nav.NavigateTo("play");
    }
}
