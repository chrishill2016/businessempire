<div class="panel status-panel">
    <div class="d-flex justify-space-between align-center">
        <div class="d-flex align-center gap-2" style="min-width:0">
            <NeonIcon Kind="NeonIconKind.Zones" Size="20" />
            <div style="min-width:0">
                <div class="display status-city" style="font-size:1.1rem;line-height:1.1">@City.Name.ToUpperInvariant()</div>
                <div class="muted" style="font-size:.8rem">@City.Country · <span class="danger-@City.Danger.ToString().ToLowerInvariant()">@City.Danger danger</span>@if (State.IsDaily) {<span class="status-mode"> · DAILY</span>} else if (State.Difficulty != Difficulty.Normal) {<span class="status-mode"> · @State.Difficulty.ToString().ToUpperInvariant()</span>}</div>
            </div>
        </div>
        <div style="text-align:right">
            <div class="display status-day" style="font-size:1.1rem;line-height:1.1">Day @State.Day / @TotalDays</div>
            <div class="@(DaysLeft <= 3 ? "negative" : "muted")" style="font-size:.8rem">
                @(DaysLeft == 0 ? "Last day!" : $"{DaysLeft} day{(DaysLeft == 1 ? "" : "s")} left")
            </div>
        </div>
    </div>

    <div class="meter my-2 @(DaysLeft <= 3 ? "warn" : null)"><div style="width:@(State.Day * 100 / TotalDays)%"></div></div>

    <div class="d-flex justify-space-between gap-2">
        <div class="stat">
            <div class="eyebrow d-flex align-center gap-1"><NeonIcon Kind="NeonIconKind.Credits" Size="12" /> Cash</div>
            <div class="money status-cash">@Money.Format(State.Cash)</div>
            @if (State.Bank > 0)
            {
                <div class="muted status-bank" style="font-size:.75rem">+ @Money.Format(State.Bank) banked</div>
            }
        </div>
        <div class="stat">
            <div class="eyebrow d-flex align-center gap-1"><NeonIcon Kind="NeonIconKind.Heat" Size="12" /> Owed</div>
            <div class="money status-debt @(State.TotalDebt > 0 ? "negative" : "positive")">@Money.Format(State.TotalDebt)</div>
            @if (State.Loans.Any(l => FinanceService.IsOverdue(l, State.Day)))
            {
                <div class="negative status-overdue" style="font-size:.75rem">OVERDUE</div>
            }
        </div>
        <div class="stat" style="text-align:right">
            <div class="eyebrow d-flex align-center gap-1 justify-end"><NeonIcon Kind="NeonIconKind.Deals" Size="12" /> Case</div>
            <div class="money status-space">@State.SpaceUsed / @State.Capacity</div>
        </div>
    </div>

    <div class="d-flex gap-3 mt-2">
        <div class="d-flex align-center gap-2 flex-grow-1">
            <span class="eyebrow">HP</span>
            <div class="meter flex-grow-1 @(State.Health < 35 ? "warn" : null)"><div style="width:@(State.Health)%"></div></div>
            <span class="money status-health @(State.Health < 35 ? "negative" : null)" style="font-size:.85rem">@State.Health</span>
        </div>
        <div class="d-flex align-center gap-2 flex-grow-1">
            <span class="eyebrow">Heat</span>
            <div class="meter warn flex-grow-1"><div style="width:@(Heat)%"></div></div>
            <span class="money status-heat @(Heat >= 50 ? "negative" : null)" style="font-size:.85rem">@Heat</span>
        </div>
    </div>
    @if (State.CrackdownIn(State.CityId) is { Known: true } crackdown)
    {
        <div class="crackdown-badge mt-1 status-crackdown">🚨 Police crackdown here until day @crackdown.EndDay. Stops are far more likely.</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public GameState State { get; set; } = default!;
    [Parameter, EditorRequired] public int TotalDays { get; set; }

    private City City => GameCatalog.City(State.CityId);
    private int DaysLeft => TotalDays - State.Day;
    private int Heat => State.HeatIn(State.CityId);
}
