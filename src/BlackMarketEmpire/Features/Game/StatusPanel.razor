<MudPaper Class="pa-3" Elevation="2">
    <div class="d-flex justify-space-between align-center">
        <div>
            <MudText Typo="Typo.h6" Class="status-city">📍 @GameCatalog.City(State.CityId).Name</MudText>
            <MudText Typo="Typo.caption">@GameCatalog.City(State.CityId).Country</MudText>
        </div>
        <div style="text-align:right">
            <MudText Typo="Typo.h6" Class="status-day">Day @State.Day / @TotalDays</MudText>
            <MudText Typo="Typo.caption" Color="@(DaysLeft <= 3 ? Color.Warning : Color.Default)">
                @(DaysLeft == 0 ? "Last day!" : $"{DaysLeft} day{(DaysLeft == 1 ? "" : "s")} left")
            </MudText>
        </div>
    </div>
    <MudProgressLinear Value="@(State.Day * 100.0 / TotalDays)" Color="@(DaysLeft <= 3 ? Color.Warning : Color.Primary)" Class="my-2" Rounded="true" />
    <MudGrid Spacing="1">
        <MudItem xs="4">
            <MudText Typo="Typo.caption">Cash</MudText>
            <MudText Typo="Typo.subtitle1" Class="money status-cash">£@State.Cash.ToString("N0")</MudText>
        </MudItem>
        <MudItem xs="4">
            <MudText Typo="Typo.caption">Debt</MudText>
            <MudText Typo="Typo.subtitle1" Class="@($"money status-debt {(State.Debt > 0 ? "negative" : "positive")}")">£@State.Debt.ToString("N0")</MudText>
        </MudItem>
        <MudItem xs="4">
            <MudText Typo="Typo.caption">Suitcase</MudText>
            <MudText Typo="Typo.subtitle1" Class="status-space">@State.UnitsHeld / @State.Capacity</MudText>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    [Parameter, EditorRequired] public GameState State { get; set; } = default!;
    [Parameter, EditorRequired] public int TotalDays { get; set; }

    private int DaysLeft => TotalDays - State.Day;
}
