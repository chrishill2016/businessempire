@page "/play"
@inject GameSession Session
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Day @(Session.State?.Day) · Black Market Empire</PageTitle>

@if (Session.State is { } state)
{
    var lastDay = state.Day >= Session.Engine.Rules.TotalDays;
    <div class="play-layout">
        <div class="play-top">
            <StatusPanel State="state" TotalDays="Session.Engine.Rules.TotalDays" />
        </div>

        <div class="play-scroll" id="play-scroll">
            @if (lastDay)
            {
                <div class="panel pa-3 mb-2 d-flex align-center gap-2" style="border-color:var(--bme-magenta)">
                    <NeonIcon Kind="NeonIconKind.Heat" Size="20" />
                    <span>Last day! Sell everything and pay your debts. Unsold goods, including anything in a stash, are worthless when the run ends.</span>
                </div>
            }

            @if (state.News.FirstOrDefault() is { } latest)
            {
                <a class="intel-ticker panel mb-2" href="play#intel" @onclick:preventDefault @onclick="ScrollToIntel">
                    <span class="news-kind @(latest.Kind == MarketEventKind.Spike ? "spike" : "crash")">@NewsFeed.KindLabel(latest.Kind)</span>
                    <span class="intel-ticker-text">@latest.Headline</span>
                </a>
            }

            <MarketList State="state" Disabled="_busy" OnTrade="OpenTrade" />

            @if (state.Shipments.Count > 0)
            {
                <div class="mt-3">
                    <DeliveriesPanel State="state" Disabled="_busy" OnCollect="@(() => Run(Session.CollectAsync))" />
                </div>
            }

            <div class="mt-3" id="intel">
                <NewsFeed Items="state.News" />
            </div>

            <div class="panel pa-4 mt-3">
                <div class="eyebrow mb-2">Activity log</div>
                @foreach (var (line, i) in state.Log.Take(6).Select((l, i) => (l, i)))
                {
                    <div class="log-line @(i == 0 ? "latest" : null)"><span class="log-caret">&gt;</span> @line</div>
                }
            </div>

            @if (!lastDay)
            {
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Default" Class="mt-2 mb-2 muted" OnClick="ConfirmEndEarly">
                    Retire early (end run now)
                </MudButton>
            }
        </div>

        <nav class="action-bar" aria-label="Actions">
            <button type="button" class="action-btn primary" disabled="@(_busy || lastDay)" @onclick="OpenTravel">
                <MudIcon Icon="@Icons.Material.Filled.Flight" Size="Size.Small" /><span>Travel</span>
            </button>
            <button type="button" class="action-btn" disabled="@_busy" @onclick="WaitOrEnd">
                <MudIcon Icon="@(lastDay ? Icons.Material.Filled.Flag : Icons.Material.Filled.Bedtime)" Size="Size.Small" /><span>@(lastDay ? "End run" : "Wait")</span>
            </button>
            <button type="button" class="action-btn" disabled="@_busy" @onclick="OpenGear">
                <MudIcon Icon="@Icons.Material.Filled.Backpack" Size="Size.Small" /><span>Gear</span>
            </button>
            <button type="button" class="action-btn" disabled="@(_busy || state.Inventory.Count == 0 || lastDay)" @onclick="OpenShip">
                <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Small" /><span>Ship</span>
            </button>
            <button type="button" class="action-btn money-btn" disabled="@_busy" @onclick="@(() => Nav.NavigateTo("finance"))">
                <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" /><span>Money</span>
            </button>
            <button type="button" class="action-btn" disabled="@_busy" @onclick="@(() => Nav.NavigateTo("stash"))">
                <MudIcon Icon="@Icons.Material.Filled.Warehouse" Size="Size.Small" /><span>Stash</span>
            </button>
            <button type="button" class="action-btn" disabled="@_busy" @onclick="@(() => Nav.NavigateTo("intel"))">
                <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" /><span>Intel</span>
            </button>
        </nav>
    </div>
}
else if (_loaded)
{
    <div class="page">
        <MudText>No run in progress.</MudText>
        <MudButton Href="" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">Back to start</MudButton>
    </div>
}

@code {
    private bool _loaded;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await Session.LoadAsync();
        _loaded = true;
        if (Session.State is { IsOver: true })
        {
            Nav.NavigateTo("game-over");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Resume an encounter that was in progress when the app was closed.
        if (firstRender && Session.State is { IsOver: false, PendingEncounter: not null })
        {
            await HandleEncounters();
        }
    }

    /// <summary>Keeps showing the encounter until it's resolved (a failed run means they're still after you).</summary>
    private async Task HandleEncounters()
    {
        while (Session.State is { IsOver: false, PendingEncounter: not null } state)
        {
            var parameters = new DialogParameters<EncounterDialog>
            {
                { d => d.State, state },
                { d => d.Rules, Session.Engine.Rules },
            };
            var options = new DialogOptions { BackdropClick = false, CloseOnEscapeKey = false, CloseButton = false };
            var dialog = await Dialogs.ShowAsync<EncounterDialog>(null, parameters, options);
            var result = await dialog.Result;
            if (result is not { Canceled: false, Data: EncounterChoice choice }) continue;

            var outcome = await Session.ResolveEncounterAsync(choice);
            Snackbar.Notify(outcome.Message, outcome.Success);
            StateHasChanged();
        }
        if (Session.State is { IsOver: true })
        {
            Nav.NavigateTo("game-over");
        }
    }

    private async Task OpenTrade((Good Good, TradeMode Mode) args)
    {
        var state = Session.State!;
        var (good, mode) = args;
        var max = mode == TradeMode.Buy ? Session.Engine.MaxBuyable(state, good.Id) : Session.Engine.Held(state, good.Id);
        var parameters = new DialogParameters<TradeDialog>
        {
            { d => d.Good, good },
            { d => d.Mode, mode },
            { d => d.Price, state.Market[good.Id] },
            { d => d.Max, max },
        };
        var dialog = await Dialogs.ShowAsync<TradeDialog>(null, parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: int qty })
        {
            await Run(() => mode == TradeMode.Buy ? Session.BuyAsync(good.Id, qty) : Session.SellAsync(good.Id, qty));
        }
    }

    private async Task OpenTravel()
    {
        var parameters = new DialogParameters<TravelDialog>
        {
            { d => d.State, Session.State! },
            { d => d.Engine, Session.Engine },
        };
        var dialog = await Dialogs.ShowAsync<TravelDialog>(null, parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: TravelChoice choice })
        {
            await Run(() => Session.TravelAsync(choice.CityId, choice.Method));
        }
    }

    private async Task OpenGear()
    {
        var parameters = new DialogParameters<GearDialog>
        {
            { d => d.State, Session.State! },
            { d => d.Rules, Session.Engine.Rules },
        };
        var dialog = await Dialogs.ShowAsync<GearDialog>(null, parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: GearAction action })
        {
            await Run(() => action.Use ? Session.UseFirstAidAsync() : Session.BuyGearAsync(action.GearId));
        }
    }

    private async Task OpenShip()
    {
        var parameters = new DialogParameters<ShipDialog>
        {
            { d => d.State, Session.State! },
            { d => d.Engine, Session.Engine },
        };
        var dialog = await Dialogs.ShowAsync<ShipDialog>(null, parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ShipOrder order })
        {
            await Run(() => Session.ShipAsync(order.GoodId, order.Quantity, order.ToCityId, order.CourierId));
        }
    }

    private async Task ScrollToIntel() =>
        await JS.InvokeVoidAsync("bme.scrollToId", "intel");

    private Task WaitOrEnd() => Run(Session.WaitAsync);

    private async Task ConfirmEndEarly()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Retire early?",
            "Your run ends now. Score = cash minus debt; anything you're carrying is worthless.",
            yesText: "End run", cancelText: "Keep playing");
        if (confirmed == true)
        {
            await Run(Session.EndRunAsync);
        }
    }

    private async Task Run(Func<Task<ActionResult>> action)
    {
        _busy = true;
        try
        {
            var result = await action();
            if (Session.State is { PendingEncounter: not null })
            {
                StateHasChanged();
                await HandleEncounters();
                return;
            }
            Snackbar.Notify(result.Message, result.Success);
            if (Session.State is { IsOver: true })
            {
                Nav.NavigateTo("game-over");
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
