<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2"><NeonIcon Kind="NeonIconKind.Zones" Size="22" /><span class="display">WHERE TO?</span></div>
    </TitleContent>
    <DialogContent>
        <div class="muted" style="font-size:.9rem">
            Fares are paid up front. Flights are fast but airport customs are the strictest. Boats are slow but quiet.
            @if (State.UnitsHeld == 0) { <b> You're carrying nothing, so nobody will stop you.</b> }
        </div>
        @foreach (var region in GameCatalog.Regions)
        {
            var cities = GameCatalog.Cities
                .Where(c => c.Region == region && c.Id != State.CityId)
                .OrderBy(c => GameCatalog.DaysBetween(State.CityId, c.Id))
                .ToList();
            if (cities.Count == 0) continue;
            <div class="eyebrow mt-4 travel-region">@region</div>
        @foreach (var city in cities)
        {
            var options = Engine.TravelOptions(State, city.Id);
            var intel = State.News.Where(n => n.CityId == city.Id && n.Status is NewsStatus.Rumour or NewsStatus.Tip).ToList();
            var heat = State.HeatIn(city.Id);
            <div class="travel-city panel pa-3 mt-3" data-city="@city.Id">
                <div class="d-flex justify-space-between align-center">
                    <span><b>@city.Name</b> <span class="muted">@city.Country</span> <span class="danger-@city.Danger.ToString().ToLowerInvariant()" style="font-size:.8rem">· @city.Danger danger</span></span>
                    @if (State.Crackdowns.FirstOrDefault(c => c.CityId == city.Id && c.Known && c.EndDay >= State.Day) is { } cd)
                    {
                        <span class="crackdown-badge" data-crackdown="@city.Id">🚨 Crackdown d@(cd.StartDay)–@(cd.EndDay)</span>
                    }
                    @if (HasScanner && heat > 0)
                    {
                        <span class="negative" style="font-size:.85rem"><NeonIcon Kind="NeonIconKind.Heat" Size="14" /> Heat @heat</span>
                    }
                </div>
                @if (intel.Count > 0)
                {
                    <div class="city-intel" data-intel="@city.Id">
                        @foreach (var n in intel)
                        {
                            <span class="@(n.Kind == MarketEventKind.Spike ? "spike" : "crash")">
                                @(n.Kind == MarketEventKind.Spike ? "▲" : "▼") @GameCatalog.Good(n.GoodId).Name <span class="muted">(@(n.Status == NewsStatus.Tip ? $"tip, from day {n.StartsDay}" : n.InformantSaysTrue is { } says ? (says ? "informant: real" : "informant: rubbish") : $"rumour, day {n.Day}"))</span>
                            </span>
                        }
                    </div>
                }
                <div class="travel-options mt-2">
                    @foreach (var o in options.Where(o => o.Reason is not ("No road or rail route" or "Needs a port at both ends")))
                    {
                        <button type="button" class="travel-option @(o.Available ? null : "disabled")" disabled="@(!o.Available)"
                                data-method="@o.Method" @onclick="@(() => Dialog.Close(DialogResult.Ok(new TravelChoice(city.Id, o.Method))))">
                            <span class="to-top">@TravelService.Icon(o.Method) @TravelService.Label(o.Method)</span>
                            <span class="to-mid">@o.Days day@(o.Days == 1 ? "" : "s") · @Money.Format(o.Fare)</span>
                            <span class="to-risk @RiskClass(o.StopChance)">
                                @(o.Available ? (HasScanner ? $"Stop {Math.Round(o.StopChance * 100)}%" : TravelService.RiskLabel(o.StopChance)) : o.Reason)
                            </span>
                        </button>
                    }
                </div>
            </div>
        }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">Stay here</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public GameState State { get; set; } = default!;
    [Parameter] public GameEngine Engine { get; set; } = default!;

    private bool HasScanner => State.Has("scanner");

    private static string RiskClass(double chance) =>
        chance >= 0.25 ? "negative" : chance >= 0.10 ? "warnish" : "positive";
}
