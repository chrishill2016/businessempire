<div class="panel">
    <div class="d-flex align-center gap-2 px-4 pt-3 pb-1">
        <NeonIcon Kind="NeonIconKind.Market" Size="18" />
        <span class="eyebrow">Today's market</span>
    </div>
    @foreach (var good in VisibleGoods)
    {
        var onSale = State.Market.TryGetValue(good.Id, out var price);
        var held = State.Inventory.GetValueOrDefault(good.Id);
        var avg = State.AverageCost.GetValueOrDefault(good.Id);
        var shock = EventService.ActiveEvent(State, State.CityId, good.Id);
        <div class="market-row d-flex align-center gap-2 px-3 py-2" data-good="@good.Id">
            <div class="good-icon">@good.Icon</div>
            <div class="flex-grow-1" style="min-width:0">
                <div style="font-weight:600;line-height:1.2">
                    @good.Name
                    @if (shock is not null)
                    {
                        <span class="event-badge @(shock.Kind == MarketEventKind.Spike ? "spike" : "crash")">@NewsFeed.KindLabel(shock.Kind)</span>
                    }
                </div>
                @if (onSale)
                {
                    <div class="money" style="font-size:1.05rem;color:var(--bme-text)">@Money.Format(price)</div>
                }
                else
                {
                    <div class="muted" style="font-size:.85rem">Not traded here today</div>
                }
                @if (held > 0)
                {
                    <div style="font-size:.85rem" class="@(onSale ? (price >= avg ? "positive" : "negative") : "muted")">
                        You have @held · paid @Money.Format(avg) each
                    </div>
                }
            </div>
            <MudStack Row="true" Spacing="1">
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="@(!onSale || Disabled)" OnClick="@(() => OnTrade.InvokeAsync((good, TradeMode.Buy)))">Buy</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                           Disabled="@(!onSale || held == 0 || Disabled)" OnClick="@(() => OnTrade.InvokeAsync((good, TradeMode.Sell)))">Sell</MudButton>
            </MudStack>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public GameState State { get; set; } = default!;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<(Good Good, TradeMode Mode)> OnTrade { get; set; }

    private IEnumerable<Good> VisibleGoods => GameCatalog.Goods
        .Where(g => State.Market.ContainsKey(g.Id) || State.Inventory.ContainsKey(g.Id));
}
