@page "/game-over"
@inject GameSession Session
@inject HighScoreService HighScores
@inject ProgressService Progress
@inject NavigationManager Nav

<PageTitle>Run over · Black Market Empire</PageTitle>

<div class="page">
    @if (_state is null)
    {
        <MudText>No finished run.</MudText>
        <MudButton Href="" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">Back to start</MudButton>
    }
    else
    {
        var score = Session.Engine.Score(_state);
        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="mt-4">
            <div class="display @(_state.EndReason == EndReason.Killed ? "negative" : null) end-reason" style="font-size:1.3rem;text-align:center">@Headline(_state)</div>
            <div class="panel pa-5" style="width:100%;text-align:center">
                <div class="eyebrow mb-1">@(_state.EndReason == EndReason.Killed ? "Your cash died with you · the bank and the debts remain" : "Final net worth")</div>
                <div class="money @(score < 0 ? "negative" : "positive")" style="font-size:2.4rem;text-shadow:0 0 14px currentColor">@Money.Format(score)</div>
                <div class="muted mt-2">
                    Cash @Money.Format(_state.Cash) · Bank @Money.Format(_state.Bank) · Owed @Money.Format(_state.TotalDebt) · Day @_state.Day in @GameCatalog.City(_state.CityId).Name
                </div>
            </div>
            @if (Session.FinalRank is int rank)
            {
                <MudAlert Severity="@(rank == 1 ? Severity.Success : Severity.Info)" Dense="true">
                    @(rank == 1 ? "New top score!" : $"You placed #{rank} on your high scores.")
                </MudAlert>
            }
            @if (_state.UnitsHeld > 0)
            {
                <MudText Typo="Typo.caption" Class="negative">You finished with @_state.UnitsHeld unsold items — they're worth nothing now.</MudText>
            }
            <div class="muted run-label" style="font-size:.9rem">@HomePage.RunLabel(_state)</div>
            @if (Session.NewAchievements.Count > 0)
            {
                <div style="width:100%" class="new-achievements">
                    <div class="eyebrow mb-2">Achievements unlocked</div>
                    <AchievementList Items="Session.NewAchievements" Unlocked="_unlocked" Fresh="@Session.NewAchievements.Select(a => a.Id).ToList()" />
                </div>
            }
            <div style="width:100%"><RapSheet Stats="_state.Stats" Reason="_state.EndReason" /></div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" OnClick="PlayAgain" Class="mt-2" Style="height:56px">
                Play again (@(_state.Difficulty.ToString().ToLowerInvariant()))
            </MudButton>
        </MudStack>

        <div class="eyebrow mt-6 mb-2">High scores</div>
        @if (_scores is not null)
        {
            <HighScoreTable Scores="_scores" Highlight="_state.RunId" PageSize="10" />
        }
    }
</div>

@code {
    private GameState? _state;
    private IReadOnlyList<HighScore>? _scores;
    private Dictionary<string, DateTime> _unlocked = [];

    protected override async Task OnInitializedAsync()
    {
        await Session.LoadAsync();
        _state = Session.State is { IsOver: true } s ? s : null;
        _scores = await HighScores.GetTopAsync();
        _unlocked = await Progress.GetUnlockedAsync();
    }

    private static string Headline(GameState state) => state.EndReason switch
    {
        EndReason.Killed => "YOU WERE KILLED",
        EndReason.Retired => "YOU RETIRED EARLY",
        _ => "30 DAYS ARE UP",
    };

    private async Task PlayAgain()
    {
        await Session.StartNewAsync(_state?.Difficulty ?? Difficulty.Normal);
        Nav.NavigateTo("play");
    }
}
