@page "/scores"
@inject HighScoreService HighScores

<PageTitle>High scores · Black Market Empire</PageTitle>

<div class="page">
    <MudText Typo="Typo.h5" Class="mb-3">🏆 High scores</MudText>
    @if (_scores is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <HighScoreTable Scores="_scores" />
    }
    <MudButton Href="" Variant="Variant.Text" Class="mt-4" StartIcon="@Icons.Material.Filled.ArrowBack">Back</MudButton>
</div>

@code {
    private IReadOnlyList<HighScore>? _scores;

    protected override async Task OnInitializedAsync() => _scores = await HighScores.GetTopAsync();
}
